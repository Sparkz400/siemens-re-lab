FUNCTION "FC_LogicB" : VOID
VAR_INPUT
  Start : BOOL;
  Stop : BOOL;
END_VAR
VAR_OUTPUT
  Motor : BOOL;
  Fault : BOOL;
END_VAR
BEGIN
  Motor := Start AND NOT Stop;
  Fault := Stop;
END_FUNCTION

FUNCTION "FC_And" : VOID
VAR_INPUT
  A : BOOL;
  B : BOOL;
END_VAR
VAR_OUTPUT
  Out : BOOL;
END_VAR
BEGIN
  Out := A AND B;
END_FUNCTION

FUNCTION "FC_Or" : VOID
VAR_INPUT
  A : BOOL;
  B : BOOL;
END_VAR
VAR_OUTPUT
  Out : BOOL;
END_VAR
BEGIN
  Out := A OR B;
END_FUNCTION

FUNCTION "FC_Not" : VOID
VAR_INPUT
  A : BOOL;
END_VAR
VAR_OUTPUT
  Out : BOOL;
END_VAR
BEGIN
  Out := NOT A;
END_FUNCTION

FUNCTION "FC_Xor" : VOID
VAR_INPUT
  A : BOOL;
  B : BOOL;
END_VAR
VAR_OUTPUT
  Out : BOOL;
END_VAR
BEGIN
  Out := A XOR B;
END_FUNCTION

FUNCTION "FC_Mux" : VOID
VAR_INPUT
  Select : BOOL;
  A : BOOL;
  B : BOOL;
END_VAR
VAR_OUTPUT
  Out : BOOL;
END_VAR
BEGIN
  IF Select THEN
    Out := A;
  ELSE
    Out := B;
  END_IF;
END_FUNCTION

FUNCTION "FC_Cmp" : VOID
VAR_INPUT
  A : INT;
  B : INT;
END_VAR
VAR_OUTPUT
  Out : BOOL;
END_VAR
BEGIN
  Out := A > B;
END_FUNCTION

FUNCTION "FC_Add" : VOID
VAR_INPUT
  A : INT;
  B : INT;
END_VAR
VAR_OUTPUT
  Out : INT;
END_VAR
BEGIN
  Out := A + B;
END_FUNCTION
